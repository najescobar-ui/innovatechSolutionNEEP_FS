  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login (obtener token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{keycloak}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloak}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Password grant contra Keycloak. Guarda access_token en {{token}} y refresh_token en {{refresh_token}}.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.access_token) {",
                  "  pm.collectionVariables.set('token', d.access_token);",
                  "  pm.collectionVariables.set('refresh_token', d.refresh_token || '');",
                  "  pm.test('token recibido', function () { pm.expect(d.access_token).to.be.a('string'); });",
                  "} else {",
                  "  pm.test('login falló', function () { pm.expect.fail('sin access_token: ' + pm.response.text()); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro de cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea un usuario en Keycloak vía el BFF. Endpoint público (no requiere token). role ∈ {DEV, PM, DIR}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Díaz\",\n  \"email\": \"ana@innovatech.cl\",\n  \"rut\": \"12.345.678-5\",\n  \"password\": \"Secret.1\",\n  \"role\": \"DEV\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });"
                ]
              }
            }
          ]
        }
      ]
    },
